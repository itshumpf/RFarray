# csi_cfo defaults
CONFIG_ESP_CONSOLE_UART_BAUDRATE=460800
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_CSI_ENABLED=y
# Binary serial output must NOT have \n translated to \r\n
CONFIG_LIBC_STDOUT_LINE_ENDING_LF=y
# Custom UART console = same UART0/GPIO1/GPIO3 as Default, but unlocks the baud field
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_TX_GPIO=1
CONFIG_ESP_CONSOLE_UART_RX_GPIO=3
